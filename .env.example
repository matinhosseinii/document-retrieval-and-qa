# Django
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_PATH=db.sqlite3
DJANGO_TIME_ZONE=Asia/Tehran

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_GENERATION_TIMEOUT=30000
OPENROUTER_EMBEDDING_TIMEOUT_MS=30000
OPENROUTER_EMBEDDING_RETRIES=1

# Retrieval and generation
RAG_TOP_K=4
RAG_TEMPERATURE=0.1
RAG_MAX_TOKENS=512
RAG_MAX_RETRIES=0

# Document chunking
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120

# Chroma
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=documents_nemotron3
